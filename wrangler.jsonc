{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mallorca-riders-preview",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/overpass"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "previews": {}
}
